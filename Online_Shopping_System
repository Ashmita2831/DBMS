-- SELECT query
select * from customers;
select * from categories;
select * from products;
select * from orders;
select * from transactions;

-- USING WHERE CLAUSE : Display products priced above ₹1000
SELECT product_name, price FROM products 
WHERE price > 1000;
 
-- USING GROUP BY AND HAVING:
-- shows customers whose average order value exceeds ₹500.
SELECT customer_id,AVG(total_amount) AS avg_order_value
FROM orders
GROUP BY customer_id
HAVING AVG(total_amount) > 500;

-- USING JOINS:
-- Show transaction details with customer name and total amount
SELECT t.transaction_id, c.name AS customer_name, t.amount, t.transaction_date
FROM transactions t
JOIN orders o ON t.order_id = o.order_id
JOIN customers c ON o.customer_id = c.customer_id;

-- Show all customers and orders (including unmatched ones)
SELECT c.customer_id,c.name AS customer_name,o.order_id,o.order_date
FROM customers c
LEFT JOIN orders o ON c.customer_id = o.customer_id;
